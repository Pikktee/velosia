<?xml version="1.0" encoding="utf-8"?>
<!-- Background of the in-app update bar (MainActivity.renderUpdateBar): the frontend's
     dark glass card (#11151e, faint border), so it reads as part of the app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#11151e" />
    <stroke android:width="1dp" android:color="#1fffffff" />
    <corners android:radius="14dp" />
</shape>
