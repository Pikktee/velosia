<?xml version="1.0" encoding="utf-8"?>
<!-- Shown instead of Google's / Facebook's "Dieser Browser oder diese App ist unter
     Umständen nicht sicher" when a platform's social sign-in starts inside the WebView.
     Texts are set in MainActivity.showSocialLoginHint (provider and platform names). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/login_hint_bg"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/login_hint_handle" />

    <TextView
        android:id="@+id/loginHintTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#f3f6f8"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/loginHintBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="#c3ccd4"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/login_hint_tip_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Noch kein Passwort?"
            android:textColor="#09b0b7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginHintTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="#c3ccd4"
            android:textSize="14sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginHintOk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="22dp"
        android:text="Verstanden"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="16sp"
        app:backgroundTint="#09b0b7"
        app:cornerRadius="14dp" />
</LinearLayout>
