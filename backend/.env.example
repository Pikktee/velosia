# Velosia Backend Environment Configuration
# Copy this file to .env in the same directory and fill in your values.

# Google Gemini API Key (get it from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret key for token and URL signing. Required, at least 32 characters, random.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth Client ID for Social Login (obtain from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Admin e-mails (comma-separated, lower-case). Required for admin access —
# there is no default, so without it no account has admin rights.
ADMIN_EMAILS=

# Lifetime of the draft-scoped token used while publishing in the app (minutes)
PLATFORM_TOKEN_TTL_MIN=180


# --- Optional (defaults shown) ---
# Interactive API docs (/docs, /redoc, /openapi.json) — only for local development.
# ENABLE_API_DOCS=0
# Additional allowed CORS origins (comma-separated, exact), e.g. a preview frontend.
# CORS_EXTRA_ORIGINS=
# Engine diagnostic beacon (/api/telemetry/debug); off = requests are discarded.
# DEBUG_BEACON_ENABLED=0
# Photo uploads: max bytes per file, longest stored edge, max photos per request.
# MAX_UPLOAD_BYTES=26214400
# MAX_STORED_IMAGE_DIM=2560
# MAX_FILES_UPLOAD=20
# MAX_FILES_TURBO=40
# Refuse uploads when less free space is left on the volume (MB).
# MIN_FREE_DISK_MB=200
# AI cost control: images per user per rolling 24 h, and across all users (0 = off).
# DAILY_IMAGE_QUOTA=150
# GLOBAL_DAILY_IMAGE_CAP=0
